# Server
PORT=4000

# Dashboard login password (change this!)
DASH_PASSWORD=change-me

# On Railway/cloud hosts, skip slow website scraping during discovery (optional)
# SKIP_ENRICHMENT=true

# Outbound email (SMTP). Leave unset to run in dry-run mode:
# emails are rendered and logged but not actually sent.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=rafi@dvpartners.org
SMTP_PASS=
SMTP_FROM="D&V Partners <rafi@dvpartners.org>"
REPLY_TO=rafi@dvpartners.org

# Reply-to shown on outbound quotes
REPLY_TO=rafi@dvpartners.org

# Stannp print-and-post (https://www.stannp.com) for the letter queue.
# Leave unset to fall back to manual printing. Set STANNP_TEST=true to
# generate sample PDFs without dispatching or being charged.
STANNP_API_KEY=
STANNP_TEST=true
