# Server
PORT=4000

# Dashboard login password (change this!)
DASH_PASSWORD=change-me

# Optional: set SKIP_ENRICHMENT=true for faster discovery (skips website email scraping).

# --- Email on Railway (REQUIRED for Hobby/Free plan) ---
# Railway blocks outbound SMTP (ports 465 & 587). Use Resend instead:
# 1. Sign up at https://resend.com
# 2. Add & verify domain dvpartners.org (DNS records in Resend dashboard)
# 3. Create API key → paste below
RESEND_API_KEY=
RESEND_FROM=D&V Partners <rafi@dvpartners.org>
REPLY_TO=rafi@dvpartners.org

# --- Email locally (optional — direct Spacemail SMTP) ---
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=rafi@dvpartners.org
SMTP_PASS=
SMTP_FROM=D&V Partners <rafi@dvpartners.org>

# Stannp print-and-post (https://www.stannp.com) for the letter queue.
STANNP_API_KEY=
STANNP_TEST=true
